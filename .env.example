# Datenbank: SQLite für lokalen Start; für Postgres:
#   provider in prisma/schema.prisma auf "postgresql" ändern und URL anpassen,
#   z. B. DATABASE_URL="postgresql://user:pass@localhost:5432/bubbel"
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-please-min-32-chars-long-secret"

# Optional: Google OAuth (leer lassen => nur E-Mail/Passwort-Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# KI-Anbieter (für Konversationsmodus + Lektions-Generator) – EINEN eintragen:
# Kostenlos & empfohlen: https://aistudio.google.com → API-Key (Gemini, ~1500 Anfragen/Tag, keine Kreditkarte)
GEMINI_API_KEY=""
# Kostenlos, aber schwächer bei Türkisch: https://console.groq.com (Llama)
GROQ_API_KEY=""
# Beste Qualität (bes. für den Generator): https://console.anthropic.com (ab 5 $ Guthaben)
ANTHROPIC_API_KEY=""
# Ohne Key funktioniert die App normal, nur Bot-Chat und Generator zeigen einen Hinweis.
# Auswahl automatisch: Anthropic → Gemini → Groq. Erzwingen mit LLM_PROVIDER.
LLM_PROVIDER=""
GEMINI_MODEL="gemini-2.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
CHAT_MODEL="claude-haiku-4-5-20251001"
GENERATOR_MODEL="claude-sonnet-5"
